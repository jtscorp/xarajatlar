<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="qr_scan"
        android:enabled="true"
        android:icon="@drawable/ic_qr_code"
        android:shortcutShortLabel="@string/shortcut_qr_scan"
        android:shortcutLongLabel="@string/shortcut_qr_scan_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="uz.jtscorp.xarajatlar"
            android:targetClass="uz.jtscorp.xarajatlar.ui.auth.LockActivity">
            <extra android:name="shortcut_target" android:value="qr_scan" />
        </intent>
    </shortcut>

    <shortcut
