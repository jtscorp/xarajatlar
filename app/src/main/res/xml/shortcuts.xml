        android:shortcutShortLabel="@string/shortcut_ocr_scan"
        android:shortcutLongLabel="@string/shortcut_ocr_scan_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="uz.jtscorp.xarajatlar"
            android:targetClass="uz.jtscorp.xarajatlar.ui.auth.LockActivity">
