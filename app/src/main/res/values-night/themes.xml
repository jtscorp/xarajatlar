<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Xarajatlar" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorPrimaryVariant">@color/app_primary_container</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/app_primary</item>
        <item name="colorSecondaryVariant">@color/app_primary_container</item>
        <item name="colorOnSecondary">@color/app_on_primary</item>
        <item name="colorSecondaryContainer">@color/app_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/app_on_primary_container</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/app_background</item>
        <item name="colorSurfaceContainer">@color/app_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/app_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Navigation bar color - match surface for seamless bottom nav -->
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="materialCardViewStyle">@style/Widget.Xarajatlar.CardView</item>
        <item name="materialButtonStyle">@style/Widget.Xarajatlar.Button</item>
        <!-- Shape appearance - Soliq app style rounded corners -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Xarajatlar.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Xarajatlar.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Xarajatlar.LargeComponent</item>
    </style>

    <!-- Shape appearances for rounded corners -->
    <style name="ShapeAppearance.Xarajatlar.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/corner_radius_small</item>
    </style>

    <style name="ShapeAppearance.Xarajatlar.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/corner_radius_medium</item>
    </style>

    <style name="ShapeAppearance.Xarajatlar.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/corner_radius_large</item>
    </style>

    <!-- Card style with large rounded corners -->
    <style name="Widget.Xarajatlar.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/corner_radius_large</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/app_surface_variant</item>
        <item name="cardBackgroundColor">@color/app_surface</item>
    </style>

    <style name="Widget.Xarajatlar.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">@dimen/corner_radius_medium</item>
    </style>

    <style name="Widget.Xarajatlar.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_small</item>
    </style>

    <!-- Pill-shaped button style -->
    <style name="Widget.Xarajatlar.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
    </style>
</resources>
